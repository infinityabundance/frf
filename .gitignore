# The empirical program (Phase 9) regenerates its corpus and report each
# run; CI asserts on a fresh report, so neither is tracked.
/golden/work/experiment/
/golden/work/experiment.json
# The external empirical program (v1 + v2) likewise regenerates its case
# working dirs and reports each run.
/golden/work/external-experiment/
/golden/work/external-experiment.json
/golden/work/external-experiment-v2/
/golden/work/external-experiment-v2.json
# v3/v4 (the ACTUAL upstream releases and the comparative measurement study)
# regenerate their working dirs and reports the same way.
/golden/work/external-experiment-v3/
/golden/work/external-experiment-v3.json
/golden/work/external-experiment-v4/
/golden/work/external-experiment-v4.json

# The v3 corpus build workdir (fetched pinned sources + build log; transient,
# regenerated by external-corpus/v3/build/build-all.sh).
/external-corpus/v3/build/work/

# The v3 corpus BUILD PRODUCTS (the heartbleed/shellshock/log4shell binaries)
# are NOT committed: every artifact is pinned by SHA-256 in
# external-corpus/v3/build/build-manifest.json and materialized hermetically by
# external-corpus/v3/build/build-all.sh (needs podman/docker + network). A
# fresh clone builds them once; CI does NOT build them, and the xtask
# empirical programs skip a case whose build products are absent (recorded in
# the report). The log4shell launcher wrappers (run-vuln.sh / run-fixed.sh) are
# small tracked scripts, not build products.
/external-corpus/v3/heartbleed/builds/
/external-corpus/v3/shellshock/builds/
/external-corpus/v3/log4shell/builds/lib/
/external-corpus/v3/log4shell/builds/probe.jar

# Transient local demo artifacts (a regenerated golden tree + its copy): if
# a local tool re-runs the demo inside tests/, the protocol-registry drift
# test must stay green and the tree must stay untracked.
/tests/frf
/tests/golden
/golden/work/heartbleed-leak-study/
