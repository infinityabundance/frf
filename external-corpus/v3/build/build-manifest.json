    {
      "impact": "build-only, no behavior",
      "patch": "CFLAGS=-std=gnu89 (era-correct C semantics; gcc 14+ defaults to C23 where f() means f(void))",
      "target": "bash 4.3.x"
    },
    {
      "impact": "terminal-UI code only, never linked into the probe",
      "patch": "sed 's/-DTERMIO //' Configure; sed 's/# define TERMIO/# define TERMIOS/' crypto/ui/ui_openssl.c (termio.h removed from modern glibc)",
