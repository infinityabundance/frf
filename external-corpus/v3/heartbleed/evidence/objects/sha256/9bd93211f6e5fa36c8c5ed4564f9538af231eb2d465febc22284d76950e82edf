#!/usr/bin/env python3
"""The Heartbleed heartbeat-length minimizer — serves the κ route
`leak-minimize` under the spec {relation: reduce-claimed-payload-length,
relation_version: v1}.

CVE-2014-0160 is triggered by a heartbeat message whose CLAIMED payload
length exceeds the record's actual payload. The probe (hb.c) reads the
claimed length from the fixture marker ("malformed 0x4000"), so the fixture
IS the trigger knob: reducing the claimed length reduces the trigger.

The minimizer has no oracle — it cannot execute, it proposes — so it cannot
binary-search. It proposes the empirically minimal claimed length that
reliably produces the observable leak on the vulnerable library (OpenSSL
1.0.1f): 0x0FE9 (4073). That boundary is real and deterministic — below it,
1.0.1f constructs the heartbeat response but never flushes it to the wire
(the response write path re-enters the handshake state machine, which
returns WANT_READ and abandons the small write), so the probe observes
"malformed heartbeat silently discarded" and no leak. The boundary was
measured by sweeping the claimed length across the full 1.0.1x series
(16 consecutive deterministic runs: 0x0FE8 -> no leak, 0x0FE9 -> leak).

The CORE decides, never this program: the proposal is court-verified with
the one comparison operation — both sides re-execute on the proposed
fixture, the declared normalizers (none in this court: the projection is
pure text) re-apply, and the residual's lineage must survive.
A proposal that does not survive is recorded-but-not-accepted.

Protocol (spec/minimizer.md): reads canonical JSON frf-minimizer-request-v1,
writes canonical JSON frf-minimizer-response-v1, echoing `request_id` (the
SHA-256 of the exact request bytes).
"""
import base64
import hashlib
import json
import re
import sys

raw = sys.stdin.buffer.read()
req = json.loads(raw.decode("utf-8"))
assert req["schema_version"] == "frf-minimizer-request-v1", req
request_id = hashlib.sha256(raw).hexdigest()

fixture = base64.b64decode(req["fixture"]["raw_base64"])
original = fixture.decode("utf-8", "replace")

# The empirical minimal claimed length that still produces the observable
# leak on the vulnerable library (see the module doc).
MINIMAL_CLAIM = 0x0FE9


def parse_claim(text):
    m = re.search(r"malformed\s+(0[xX][0-9a-fA-F]+|\d+)", text)
    if not m:
        return None
    return int(m.group(1), 0)


def with_claim(text, claim):
    return re.sub(r"(malformed\s+)(0[xX][0-9a-fA-F]+|\d+)", r"\g<1>0x%04X" % claim, text)


claim = parse_claim(original)
if claim is None or claim <= 0:
    response = {
        "schema_version": "frf-minimizer-response-v1",
        "request_id": request_id,
        "fixture_sha256": "",
        "fixture_base64": "",
        "minimal": False,
        "attempts": [],
        "indeterminate": True,
        "failure": "the fixture does not carry a malformed-heartbeat claimed length",
    }
    json.dump(response, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    sys.exit(0)

# The search the minimizer models: halve the claim toward the empirical
# floor, then one final probe at the floor. The log is the minimizer's own
# (unverified) record; the CORE records which proposal actually survived.
proposal_claim = min(MINIMAL_CLAIM, max(1, claim - 1))
proposal = with_claim(original, proposal_claim).encode()

attempts = []
step = claim
while step > proposal_claim:
    step = max(proposal_claim, step // 2)
    candidate = with_claim(original, step).encode()
    attempts.append(
        {
            "attempt": str(len(attempts) + 1),
            "fixture_sha256": hashlib.sha256(candidate).hexdigest(),
            "kept": False,  # unverified consideration; the core decides
        }
    )
attempts.append(
    {
        "attempt": str(len(attempts) + 1),
        "fixture_sha256": hashlib.sha256(proposal).hexdigest(),
        "kept": True,  # the minimizer's proposal; the core court-verifies it
    }
)

if proposal == fixture:
    response = {
        "schema_version": "frf-minimizer-response-v1",
        "request_id": request_id,
        "fixture_sha256": "",
        "fixture_base64": "",
        "minimal": False,
        "attempts": [],
        "indeterminate": False,
        "failure": "the claimed length is already at the empirical minimum; nothing to reduce",
    }
else:
    # The domain-aware boundary declaration: the proposal sits at an
    # OBSERVATION BOUNDARY of the claimed-payload-length parameter — at the
    # passing point (proposal_claim) the leak lineage survives; at the
    # adjacent non-passing point (one step below) it does not. The CORE
    # establishes the pair itself by executing the adjacent fixture (the
    # final verification observes the passing point); the declaration is a
    # claim, never proof.
    adjacent_claim = proposal_claim - 1
    adjacent_fixture = with_claim(original, adjacent_claim).encode()
    response = {
        "schema_version": "frf-minimizer-response-v1",
        "request_id": request_id,
        "fixture_sha256": hashlib.sha256(proposal).hexdigest(),
        "fixture_base64": base64.b64encode(proposal).decode(),
        "minimal": True,
        "minimality": {
            "kind": "boundary",
            "domain": "heartbeat.claimed_payload_length",
            "ordering": "integer-ascending",
            "passing_point": str(proposal_claim),
            "adjacent_nonpassing_point": str(adjacent_claim),
            "adjacent_fixture_sha256": hashlib.sha256(adjacent_fixture).hexdigest(),
            "adjacent_fixture_base64": base64.b64encode(adjacent_fixture).decode(),
        },
        "attempts": attempts,
        "indeterminate": False,
        "failure": None,
    }

json.dump(response, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
