#!/usr/bin/env python3
"""The Heartbleed seeded-leak mutation provider — operator id `seed-leak`,
mutation family {relation: seed-sensitive-leak, relation_version: v1},
target axes `tls.heartbeat.illegal_response` and
`memory.leak.seeded_canary`.

The court challenge is the sensitivity proof: a comparator that never sees a
leak cannot be trusted to certify "no leak". The challenge runs ONE operator
per target axis, and each operator's mutant must move EXACTLY that
dimension (specificity: nothing else may diverge). This provider therefore
branches on the requested `target_axis` and proposes the axis's OWN
deterministic, synthetic leak shape:

- for `tls.heartbeat.illegal_response`: the mutant ANSWERS the malformed
  heartbeat — exit 1 + the `HEARTBLEED` verdict on stderr, no stdout
  projection (the canary axis sees no projection -> clean);
- for `memory.leak.seeded_canary`: the mutant echoes the planted canary —
  the `hb-leak-projection len=16384 sha256=… canary=present` line on
  stdout, exit 0, no verdict (the illegal-response axis sees no answer ->
  clean).

Both mutants are deterministic and deliberately synthetic: the commitment
names a published synthetic window (canary bytes repeated), never a real
secret. A court that fails to see the seeded signal, or conflates it with
the other leak axis, is refused — the challenge records stay as evidence.

Protocol (spec/mutation.md): reads canonical JSON frf-mutation-request-v1,
writes canonical JSON frf-mutation-response-v1, echoing `request_id` (the
SHA-256 of the exact request bytes).
"""
import base64
import hashlib
import json
import sys

raw = sys.stdin.buffer.read()
req = json.loads(raw.decode("utf-8"))
assert req["schema_version"] == "frf-mutation-request-v1", req
request_id = hashlib.sha256(raw).hexdigest()

# The deterministic synthetic echoed window the commitment names: canary
# bytes repeated — the same shape the real probe reports. Its SHA-256 is the
# commitment the projection line carries.
WINDOW = b"FRF-SYNTHETIC-CANARY-SEED-" * 683
WINDOW_SHA = hashlib.sha256(WINDOW).hexdigest()

target = req["target_axis"]
if target == "tls.heartbeat.illegal_response":
    # Answers the malformed heartbeat: verdict only, no projection.
    MUTANT = (
        "#!/bin/sh\n"
        "printf '%s\\n' 'HEARTBLEED: the linked libssl echoed 16384 bytes in the heartbeat response' >&2\n"
        "exit 1\n"
    ).encode()
    affected = ["tls.heartbeat.illegal_response"]
elif target == "memory.leak.seeded_canary":
    # Echoes the planted canary: projection only, no verdict.
    MUTANT = (
        "#!/bin/sh\n"
        "printf '%%s\\n' 'hb-leak-projection len=16384 sha256=%s canary=present fraction=0.99'\n"
        "exit 0\n"
    ) % WINDOW_SHA
    MUTANT = MUTANT.encode()
    affected = ["memory.leak.seeded_canary"]
else:
    response = {
        "schema_version": "frf-mutation-response-v1",
        "request_id": request_id,
        "mutant_base64": "",
        "expected_affected_surfaces": [],
        "failure": f"unknown target axis {target!r}",
    }
    json.dump(response, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    sys.exit(0)

response = {
    "schema_version": "frf-mutation-response-v1",
    "request_id": request_id,
    "mutant_base64": base64.b64encode(MUTANT).decode(),
    "expected_affected_surfaces": affected,
    "failure": None,
}
json.dump(response, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
