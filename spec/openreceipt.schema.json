          "required": [
            "authority_versions",
            "fixture_family",
            "platforms",
            "observables",
            "normalizers",
            "replay_scope"
          ],
          "additionalProperties": false,
          "properties": {
            "authority_versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fixture_family": {
              "type": "string"
            },
            "platforms": {
