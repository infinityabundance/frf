{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/infinityabundance/frf/blob/main/spec/openreceipt.schema.json",
  "title": "OpenReceipt",
  "description": "The Forensic Residual Framework OpenReceipt (frf-receipt-v14). The body is serialized as canonical JSON (RFC 8785): keys sorted by UTF-16 code units, no whitespace, exact escaping. The receipt identity is the full SHA-256 of the canonical bytes. An OpenReceipt is immutable evidence: runner and comparator identities, the environment, the execution profile and capture bounds, and the artifacts are copied from the capture at observation time, never reconstructed, and each residual binds the exact content-addressed disposition EVENT (disposition_event_id) that supplied its disposition. Observable axes and residual kinds are open protocol identifiers (any lowercase identifier; the built-ins are exit/stderr/stdout and exit/text); an externally served observable binds the exact comparator request/result records that produced its verdict. v13 records the normalizer relations applied to the compared streams (normalizer_semantics) and the normalizer, capture-adapter, and minimizer implementations the court bound at observation time (provenance). v14 records the capture-adapter relations that defined the observations delivered to externally served axes (adapter_semantics) — the adapter extraction scheme is part of the court's question, so it enters the court semantic identity (FRF/COURT/v2).",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "court",
    "provenance",
    "comparator_semantics",
    "normalizer_semantics",
    "adapter_semantics",
    "execution_profile",
    "capture_bounds",
    "authority",
    "candidate",
    "environment",
    "fixtures",
    "observables",
    "residuals",
    "endoduction",
    "claims",
    "replay"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "frf-receipt-v14"
    },
    "run": {
      "type": "string"
    },
    "court": {
      "type": "object",
      "required": [
        "id",
        "question",
        "falsifier",
        "admissibility_envelope",
        "semantic_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        },
        "semantic_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admissibility_envelope": {
          "type": "object",
          "required": [
            "authority_versions",
            "fixture_family",
            "platforms",
            "observables",
            "normalizers",
            "replay_scope"
          ],
          "additionalProperties": false,
          "properties": {
            "authority_versions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fixture_family": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observables": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "normalizers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "replay_scope": {
              "const": "single-run"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "schema_version",
        "runner",
        "comparator_implementations",
        "normalizer_implementations",
        "adapter_implementations",
        "minimizer_implementations"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "frf-provenance-v3"
        },
        "runner": {
          "type": "object",
          "required": [
            "schema_version",
            "frf_version",
            "frf_executable_hash"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "frf-runner-v1"
            },
            "frf_version": {
              "type": "string"
            },
            "frf_executable_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "comparator_implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "implementation_hash",
              "runner_hash"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "implementation_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "runner_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "interpreter": {
                    "$ref": "#/definitions/interpreter"
                  }
                }
              }
            }
          }
        },
        "normalizer_implementations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extension_implementation"
          }
        },
        "adapter_implementations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extension_implementation"
          }
        },
        "minimizer_implementations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extension_implementation"
          }
        }
      }
    },
    "normalizer_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation_id",
          "applies_to",
          "relation_version",
          "specification_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "relation_id": {
            "type": "string"
          },
          "applies_to": {
            "type": "string",
            "enum": ["stdout", "stderr", "both"]
          },
          "relation_version": {
            "type": "string"
          },
          "specification_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "adapter_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation_id",
          "relation_version",
          "specification_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "relation_id": {
            "type": "string"
          },
          "relation_version": {
            "type": "string"
          },
          "specification_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "comparator_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation_id",
          "extractor",
          "residual_classifier",
          "relation_version",
          "specification_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "relation_id": {
            "type": "string"
          },
          "extractor": {
            "type": "string"
          },
          "residual_classifier": {
            "type": "string"
          },
          "relation_version": {
            "type": "string"
          },
          "specification_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "execution_profile": {
      "type": "string"
    },
    "capture_bounds": {
      "type": "object",
      "required": [
        "timeout_ms",
        "max_stream_bytes",
        "rlimit_as_mb",
        "rlimit_cpu_s",
        "rlimit_nofile"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "string"
        },
        "max_stream_bytes": {
          "type": "string"
        },
        "rlimit_as_mb": {
          "type": "string"
        },
        "rlimit_cpu_s": {
          "type": "string"
        },
        "rlimit_nofile": {
          "type": "string"
        }
      }
    },
    "authority": {
      "$ref": "#/definitions/authority_party"
    },
    "candidate": {
      "$ref": "#/definitions/candidate_party"
    },
    "environment": {
      "type": "object",
      "required": [
        "schema_version",
        "os",
        "architecture",
        "kernel_release",
        "locale",
        "timezone",
        "umask",
        "cwd",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "frf-environment-v2"
        },
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "kernel_release": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "umask": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "hash",
          "arguments",
          "declared_arguments"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "observables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "raw_reference_hash",
          "raw_candidate_hash",
          "comparator",
          "normalization_rules",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "axis": {
            "type": "string"
          },
          "raw_reference_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_candidate_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "comparator": {
            "type": "string"
          },
          "normalization_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "enum": [
              "pass",
              "residual"
            ]
          },
          "comparator_request": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "comparator_result": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/residual"
      }
    },
    "endoduction": {
      "type": "object",
      "required": [
        "schema_version",
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "frf-token-v1"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "residual_id",
              "token",
              "next_court",
              "blocks_claims"
            ],
            "additionalProperties": false,
            "properties": {
              "residual_id": {
                "type": "string"
              },
              "token": {
                "type": "string"
              },
              "next_court": {
                "type": "string"
              },
              "blocks_claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "positive",
        "non_claims",
        "blocked_by_open_residuals"
      ],
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_by_open_residuals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "program",
        "evidence_root",
        "argv",
        "expected_run_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "program": {
          "const": "frf"
        },
        "evidence_root": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_run_identity": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "interpreter": {
      "type": "object",
      "required": [
        "kernel_interpreter",
        "shebang_argument_bytes",
        "downstream_interpreter"
      ],
      "additionalProperties": false,
      "properties": {
        "kernel_interpreter": {
          "$ref": "#/definitions/executable"
        },
        "shebang_argument_bytes": {
          "type": "string"
        },
        "resolver": {
          "type": "object",
          "required": [
            "kind",
            "path",
            "sha256",
            "path_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "env"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "downstream_interpreter": {
          "$ref": "#/definitions/executable"
        }
      }
    },
    "executable": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "extension_implementation": {
      "type": "object",
      "required": [
        "id",
        "implementation_hash",
        "runner_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "implementation_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "interpreter": {
              "$ref": "#/definitions/interpreter"
            }
          }
        }
      }
    },
    "residual": {
      "type": "object",
      "required": [
        "id",
        "axis",
        "kind",
        "sign",
        "grammar_state",
        "raw_reference_hash",
        "raw_candidate_hash",
        "disposition",
        "disposition_event_id",
        "reproducer",
        "invariant",
        "residual_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "axis": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "sign": {
          "type": "object",
          "required": [
            "trajectory_evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "trajectory_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "coordinate_system",
                  "series",
                  "drift",
                  "slew"
                ],
                "additionalProperties": false,
                "properties": {
                  "coordinate_system": {
                    "type": "string",
                    "enum": [
                      "repeat_index",
                      "candidate_revision",
                      "authority_version",
                      "environment",
                      "time"
                    ]
                  },
                  "series": {
                    "type": "string"
                  },
                  "drift": {
                    "type": "string"
                  },
                  "slew": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "grammar_state": {
          "type": "string"
        },
        "raw_reference_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_candidate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disposition": {
          "enum": [
            "open",
            "fixed",
            "intentional",
            "environmental",
            "oracle_version",
            "harness",
            "unknown"
          ]
        },
        "disposition_event_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string"
        },
        "resolution_run_id": {
          "type": "string"
        },
        "closure_predicate": {
          "type": "string"
        },
        "reproducer": {
          "type": "string"
        },
        "invariant": {
          "type": "string"
        },
        "residual_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authority_party": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "version",
        "identity_hash",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "identity_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "string"
        },
        "interpreter": {
          "$ref": "#/definitions/interpreter"
        }
      }
    },
    "candidate_party": {
      "type": "object",
      "required": [
        "name",
        "version_or_commit",
        "build_profile",
        "identity_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version_or_commit": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        },
        "identity_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "interpreter": {
          "$ref": "#/definitions/interpreter"
        }
      }
    }
  }
}